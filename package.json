{
  "name": "work-smarter-with-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/generate.mjs && vitepress dev docs --host 127.0.0.1",
    "build": "pnpm check && node scripts/generate.mjs && vitepress build docs && node scripts/check-build.mjs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "check": "node scripts/check.mjs && node --test tests/*.test.mjs",
    "check:links": "node scripts/check.mjs --external",
    "check:stale": "node scripts/check-stale.mjs",
    "new": "node scripts/new.mjs",
    "img": "node scripts/compress-images.mjs",
    "generate": "node scripts/generate.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "7.1.2",
    "cytoscape": "3.35.0",
    "cytoscape-cose-bilkent": "4.1.0",
    "dayjs": "1.11.23",
    "debug": "^4.4.3",
    "fflate": "^0.8.2",
    "gray-matter": "^4.0.3",
    "medium-zoom": "^1.1.0",
    "mermaid": "^11.4.1",
    "sharp": "^0.34.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17"
  }
}
